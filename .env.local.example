# ===========================================
# Supabase 설정
# ===========================================

# 로컬 개발 환경 (supabase start 실행 후 출력되는 값 사용)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_local_anon_key_here

# ===========================================
# 서버 전용 환경 변수 (선택사항)
# ===========================================
# Admin API 사용 시 필요
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ===========================================
# 참고: 프로덕션 환경 변수
# ===========================================
# 프로덕션 값은 Vercel Dashboard에서 설정합니다.
# 절대 이 파일이나 코드에 프로덕션 키를 입력하지 마세요!
#
# Vercel에서 설정할 변수:
# - NEXT_PUBLIC_SUPABASE_URL (프로덕션 Supabase URL)
# - NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY (프로덕션 anon key)
